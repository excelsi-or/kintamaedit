					maxhealth = entity.Attributes.MaxHealth.Value
				end
			end
		else
			health = hum.Health
			maxhealth = hum.MaxHealth
		end
		if hum then
			esp.Billboard.TextLabel.Text = entity.Name .. " " .. math.floor(health) .. "/" .. math.floor(maxhealth)
		else
			esp.Billboard.TextLabel.Text = entity.Name
		end
		return true
	else
		return false
	end
end

