		UpdateBoatSpeed()
	end
	
	if Toggles.BoatKillAura and Toggles.BoatKillAura.Value then
		local closestEnemy
		local pvp = Toggles.PvpBoatToggle.Value
		local pve = Toggles.PveBoatToggle.Value
		for _, boat in ipairs(workspace.Boats:GetChildren()) do
			if not pvp and boat:FindFirstChild("Owner") and boat.Owner.Value and boat.Owner.Value ~= LocalPlayer then
				continue
			end
			if not pve and not boat:FindFirstChild("Owner") then
				continue
			end

			local primaryPart = boat.PrimaryPart
			if not primaryPart then
				continue
			end

			local dura = boat:FindFirstChild("Dura") 
			if not dura or dura.Value <= 0 then
				continue
			end

			local plrHRP = PlayerCharacter and PlayerCharacter:FindFirstChild("HumanoidRootPart")
			if plrHRP then
				local pos = primaryPart.Position
				local plrPos = plrHRP.Position
				local distance = (pos - plrPos).Magnitude
				if distance <= Options.BoatKillAuraSlider.Value then
					task.spawn(function()
						for i = 1, 100 do
							local args = {
								0,
								PlayerCharacter,
								boat,
								LocalPlayer.Backpack:FindFirstChild(Options.FightingStyleBox.Value),
								"Attack"
							}
							game.ReplicatedStorage.RS.Remotes.Combat.DealDamageBoat3:FireServer(unpack(args))
						end
					end)
				end
			end
		end
	end

	if Toggles.KillAura and Toggles.KillAura.Value then
		local closestEnemy
		local pvp = Toggles.PvpToggleKill.Value
		local pve = Toggles.PveToggleKill.Value
		local enemy = getClosestEntity(pvp, pve)
		
		local pos = PlayerCharacter and PlayerCharacter:FindFirstChild("HumanoidRootPart") and PlayerCharacter.HumanoidRootPart.Position
		if pos and enemy then
			local enemyHRP = enemy:FindFirstChild("HumanoidRootPart")
			if enemyHRP then
				local distance = (enemyHRP.Position - pos).Magnitude
				if distance <= Options.KillAuraSlider.Value then
					local args = {
						PlayerCharacter,
						enemy,
						"Metal Magic",
						"1",
						'["Blast",1,20,20,true,"Two Hands","25","Pulsar","Drill","Metal"]',
						1,
						1
					}
					game.ReplicatedStorage.RS.Remotes.Magic.DealAttackDamage:FireServer(unpack(args))
				end
			end
		end
	end

	for i,v in pairs(PlayerEsps) do
		if not UpdateEsp(i,v) then
			RemoveEsp(v)
			PlayerEsps[i] = nil
		end
	end

	for i,v in pairs(MobEsps) do
		if not UpdateEsp(i,v) then
			RemoveEsp(v)
			MobEsps[i] = nil
		end
	end
	Tweening.update(dt)
end)
